# Скопируйте этот файл в .env и заполните своими значениями.
# .env НЕ коммитится в git (уже в .gitignore).
# На хостинге (Render/Railway) эти переменные задаются в панели Environment Variables.

# Порт сервера (локально)
PORT=3000

# Секрет для подписи JWT — сгенерируйте случайную длинную строку:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Supabase: Project Settings → Data API / API Keys
# URL проекта, например https://abcdefgh.supabase.co
SUPABASE_URL=
# service_role ключ — СЕКРЕТНЫЙ, только сервер. Никогда не вставляйте во фронтенд.
SUPABASE_SERVICE_ROLE_KEY=

# Токен бота от @BotFather — нужен для проверки подписи Telegram Mini App.
# Только сервер, никогда не публикуйте.
BOT_TOKEN=

# Сроки жизни токенов (необязательно)
ACCESS_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
